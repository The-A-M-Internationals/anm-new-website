# ============================================================
# The A&M Internationals - Environment Variables Configuration
# ============================================================

# 1. Email / SMTP Configuration
# Microsoft 365 (Office 365) Settings for am@theaminternationals.com:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=am@theaminternationals.com
SMTP_PASS=your_email_or_app_password_here
FROM_EMAIL="The A&M Internationals <am@theaminternationals.com>"
ADMIN_EMAIL=am@theaminternationals.com

# 2. AWS S3 Configuration (for resume uploads in careers)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Subscriber emails (Resend). The key needs Full access, not "sending only".
RESEND_API_KEY=
# Optional: an existing Resend segment to use instead of creating "Website subscribers"
RESEND_SEGMENT_ID=
# Optional: the From address for subscriber emails (defaults to FROM_EMAIL)
NEWS_FROM_EMAIL=

# Public address of the site, used in sitemap and email links
NEXT_PUBLIC_SITE_URL=
